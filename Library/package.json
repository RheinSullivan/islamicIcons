{
  "name": "islamic-icons",
  "version": "0.1.3",
  "private": true,
  "description": "A framework-agnostic Islamic SVG icon library for the modern web.",
  "author": "Islamic Icons Community | Vyagra Nexus™",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "scripts": {
    "dev": "vite --config ../web-docs/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config ../web-docs/vite.config.ts",
    "preview": "vite preview --config ../web-docs/vite.config.ts",
    "docs": "vite --config ../web-docs/vite.config.ts --host 0.0.0.0",
    "icons:catalog": "bun scripts/build-catalog.ts",
    "icons:package": "bun scripts/build-package.ts",
    "icons:validate": "bun scripts/validate-icons.ts",
    "test": "node --test",
    "test:static": "node --test",
    "prepublishOnly": "bun run icons:catalog && bun run icons:package && bun run icons:validate && bun run build",
    "icons:import:google": "bun scripts/import-google.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.3",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "logo": "assets/logo-islamic-icons.svg"
}

{
  "name": "islamic-icons-monorepo",
  "version": "0.1.3",
  "private": true,
  "description": "Monorepo for Islamic Icons - a framework-agnostic Islamic SVG icon library for the modern web.",
  "author": "Islamic Icons Community | Vyagra Nexus™",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyagranexus/islamic-icons.git"
  },
  "bugs": {
    "url": "https://github.com/vyagranexus/islamic-icons/issues"
  },
  "homepage": "https://github.com/vyagranexus/islamic-icons#readme",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
		"docs": "vite --host 0.0.0.0",
		"icons:catalog": "bun scripts/build-catalog.ts",
    "icons:package": "bun scripts/build-package.ts",
    "icons:validate": "bun scripts/validate-icons.ts",
    "icons:components": "bun scripts/build-components.ts",
    "test": "node --test",
    "test:static": "node --test",
		"prepublishOnly": "bun run icons:catalog && bun run icons:package && bun run icons:validate && bun run icons:components && bun run build",
    "icons:import:google": "bun scripts/import-google.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "logo": "Web Docs/assets/logo-islamic-icons.svg"
}

---
interface Props {
  size?: number
  alt?: string
  class?: string
}
const { size = 24, alt = "Arabic Calligraphy Tall Original", class: className = "" }: Props = Astro.props
---

<img src="../../icons/god/arabic-calligraphy-tall/original.svg" {alt} width={size} height={size} class={className} />
